# Server & Environment Settings
NODE_ENV="production"
PORT=32000
APP_NAME="OmniPortfolio Tracker"
DB_FILE_PATH="./db/portfolio.sqlite"

# Security & Authentication Configuration
JWT_SECRET="replace-with-a-secure-random-32-character-secret-key"
BCRYPT_SALT_ROUNDS=14

# Node.js Server API Proxy Endpoint
VITE_API_BASE_URL="http://localhost:32000/api"

# Automated API Credentials (Optional - can also be configured in App UI)
BINANCE_TR_API_KEY=""
BINANCE_TR_API_SECRET=""
BYBIT_API_KEY=""
BYBIT_API_SECRET=""

# Free Market Data Endpoints
TEFAS_API_URL="https://www.tefas.gov.tr/api/DB/BindHistoryInfo"
TCMB_EXCHANGE_RATE_URL="https://open.er-api.com/v6/latest/TRY"
YAHOO_FINANCE_PROXY="https://query1.finance.yahoo.com/v8/finance/chart/"

# Default Chart Configuration
TRADINGVIEW_DEFAULT_EXCHANGE="BIST"
TRADINGVIEW_DEFAULT_SYMBOL="BIST:XU100"
